{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/BugTracker.Api/bin/Debug/net10.0/BugTracker.Api.dll",
      "cwd": "${workspaceFolder}/src/BugTracker.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5011"
      },
      "console": "integratedTerminal"
    }
  ]
}
